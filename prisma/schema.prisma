// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum StudentStatus {
  pending
  active
  paused
  leave
}

model Student {
  id        Int           @id @default(autoincrement())
  name      String
  notes     String
  status    StudentStatus @default(pending)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt DateTime?     @map("deleted_at") @db.Timestamptz(0)

  userId String @map("user_id") @db.Uuid

  lessons         Lesson[]
  comments        StudentComment[]
  statusHistories StudentStatusHistory[]

  @@index([userId, name, status, deletedAt])
  @@map("students")
}

model Lesson {
  id        Int       @id @default(autoincrement())
  title     String
  notes     String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(0)

  studentId Int       @map("student_id")
  student   Student   @relation(fields: [studentId], references: [id])
  payment   Payment?
  sessions  Session[]

  @@index([studentId, createdAt, deletedAt])
  @@map("lessons")
}

model Session {
  id        Int       @id @default(autoincrement())
  notes     String
  lessonAt  DateTime  @map("lesson_at") @db.Timestamptz(0)
  isDone    Boolean   @default(false) @map("is_done")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(0)

  lessonId Int    @map("lesson_id")
  lesson   Lesson @relation(fields: [lessonId], references: [id])

  feedback Feedback?

  @@index([lessonId, lessonAt, deletedAt])
  @@map("sessions")
}

model Feedback {
  id        Int       @id @default(autoincrement())
  notes     String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(0)

  sessionId Int     @unique @map("session_id")
  session   Session @relation(fields: [sessionId], references: [id])

  @@index([sessionId, deletedAt])
  @@map("feedback")
}

model Payment {
  id            Int       @id @default(autoincrement())
  amount        Int
  paymentMethod String    @map("payment_method")
  notes         String?
  paidAt        DateTime  @map("paid_at") @db.Timestamptz(0)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(0)

  lessonId Int    @map("lesson_id")
  lesson   Lesson @relation(fields: [lessonId], references: [id])

  @@unique([lessonId])
  @@index([paidAt, deletedAt, lessonId])
  @@map("payments")
}

model Meeting {
  id        Int       @id @default(autoincrement())
  name      String
  notes     String?
  phone     String?
  isDone    Boolean   @default(false) @map("is_done")
  meetingAt DateTime  @map("meeting_at") @db.Timestamptz(0)
  userId    String    @map("user_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(0)

  @@index([userId, name, isDone, deletedAt])
  @@map("meetings")
}

model StudentComment {
  id        Int       @id @default(autoincrement())
  content   String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(0)

  studentId Int     @map("student_id")
  student   Student @relation(fields: [studentId], references: [id])

  @@index([studentId, createdAt, deletedAt])
  @@map("student_comments")
}

model StudentStatusHistory {
  id        Int           @id @default(autoincrement())
  status    StudentStatus
  notes     String?
  changedAt DateTime      @default(now()) @map("changed_at") @db.Timestamptz(0)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt DateTime?     @map("deleted_at") @db.Timestamptz(0)

  studentId Int     @map("student_id")
  student   Student @relation(fields: [studentId], references: [id])

  @@index([studentId, changedAt, deletedAt])
  @@map("student_status_histories")
}
