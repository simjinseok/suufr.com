generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

// Organization (과외방)
model Organization {
  id        Int       @id @default(autoincrement())
  uuid      String    @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String // 상호명
  logoUrl   String?   @map("logo_url")
  phone     String? // 연락처
  address   String? // 주소 (지도용)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(0)

  members OrganizationMember[]

  @@map("organizations")
}

// OrganizationMember (멤버십)
// 멤버는 조직에서 생성 가능 (계정 연결 없이)
// 선택적으로 초대를 통해 사용자 계정과 1:1 연결
enum OrganizationRole {
  owner // 소유자: 모든 권한
  teacher // 선생님: 수업 관리
}

// 멤버 상태 Enum
enum MemberStatusValue {
  active // 활동중
  paused // 일시정지
  leave // 탈퇴

  @@map("MemberStatus")
}

model OrganizationMember {
  id              Int               @id @default(autoincrement())
  uuid            String            @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  name            String // 멤버 이름 (필수, 표시용)
  role            OrganizationRole  @default(teacher)
  status          MemberStatusValue @default(active) // 현재 상태
  profileImageKey String?           @map("profile_image_key")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt       DateTime?         @map("deleted_at") @db.Timestamptz(0)

  // 조직 (필수)
  organizationId Int          @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])

  // 사용자 연결 (선택) - Cognito sub 직접 참조
  userId String? @unique @map("user_id") @db.Uuid

  // 상태 변경 이력
  statuses MemberStatus[]

  @@unique([organizationId, name]) // 같은 조직 내 이름 중복 방지
  @@index([organizationId, role, deletedAt])
  @@map("organization_members")
}

// 멤버 상태 변경 이력
model MemberStatus {
  id        Int               @id @default(autoincrement())
  uuid      String            @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  status    MemberStatusValue
  notes     String? // 상태 변경 사유
  changedAt DateTime          @default(now()) @map("changed_at") @db.Timestamptz(0)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt DateTime?         @map("deleted_at") @db.Timestamptz(0)
  memberId  Int               @map("member_id")
  member    OrganizationMember @relation(fields: [memberId], references: [id])

  @@index([memberId, changedAt, deletedAt])
  @@map("member_statuses")
}

model Student {
  id              Int                  @id @default(autoincrement())
  uuid            String               @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  name            String
  notes           String
  status          StudentStatusValue   @default(pending)
  profileImageKey String?              @map("profile_image_key")
  nextPaymentAt   DateTime?            @map("next_payment_at") @db.Date
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt       DateTime?            @map("deleted_at") @db.Timestamptz(0)
  userId          String               @map("user_id") @db.Uuid
  lessons         Lesson[]
  comments        StudentComment[]
  statuses        StudentStatus[]

  @@index([userId, name, status, deletedAt])
  @@map("students")
}

model Feedback {
  id        Int       @id @default(autoincrement())
  uuid      String    @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  notes     String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(0)
  sessionId Int       @unique @map("session_id")
  session   Session   @relation(fields: [sessionId], references: [id])

  @@index([sessionId, deletedAt])
  @@map("feedback")
}

model Payment {
  id            Int       @id @default(autoincrement())
  uuid          String    @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  amount        Int
  paymentMethod String    @map("payment_method")
  notes         String?
  paidAt        DateTime  @map("paid_at") @db.Timestamptz(0)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(0)
  lessonId      Int       @unique @map("lesson_id")
  lesson        Lesson    @relation(fields: [lessonId], references: [id])

  @@index([paidAt, deletedAt, lessonId])
  @@map("payments")
}

model Meeting {
  id        Int       @id @default(autoincrement())
  uuid      String    @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String
  notes     String?
  userId    String    @map("user_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(0)
  meetingAt DateTime  @map("meeting_at") @db.Timestamptz(0)
  isDone    Boolean   @default(false) @map("is_done")
  phone     String?

  @@index([userId, name, isDone, deletedAt])
  @@map("meetings")
}

model StudentComment {
  id        Int       @id @default(autoincrement())
  uuid      String    @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  content   String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(0)
  studentId Int       @map("student_id")
  student   Student   @relation(fields: [studentId], references: [id])

  @@index([studentId, createdAt, deletedAt])
  @@map("student_comments")
}

model StudentStatus {
  id        Int                @id @default(autoincrement())
  uuid      String             @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  status    StudentStatusValue
  notes     String?
  changedAt DateTime           @default(now()) @map("changed_at") @db.Timestamptz(0)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt DateTime?          @map("deleted_at") @db.Timestamptz(0)
  studentId Int                @map("student_id")
  student   Student            @relation(fields: [studentId], references: [id])

  @@index([studentId, changedAt, deletedAt])
  @@map("student_statuses")
}

model SessionShare {
  id        Int       @id @default(autoincrement())
  uuid      String    @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  shareId   String    @unique @map("share_id") @db.VarChar(10)
  lessonId  Int       @map("lesson_id")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(0)
  lesson    Lesson    @relation(fields: [lessonId], references: [id])

  @@index([shareId, expiresAt, deletedAt])
  @@index([lessonId, deletedAt])
  @@map("session_shares")
}

model Session {
  id        Int       @id @default(autoincrement())
  uuid      String    @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  notes     String
  sessionAt DateTime  @map("session_at") @db.Timestamptz(0)
  duration  Int       @default(60)
  isDone    Boolean   @default(false) @map("is_done")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(0)
  lessonId  Int       @map("lesson_id")
  feedback  Feedback?
  lesson    Lesson    @relation(fields: [lessonId], references: [id])

  @@index([lessonId, sessionAt, deletedAt])
  @@map("sessions")
}

model Lesson {
  id        Int            @id @default(autoincrement())
  uuid      String         @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  title     String
  notes     String
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt DateTime?      @map("deleted_at") @db.Timestamptz(0)
  studentId Int            @map("student_id")
  student   Student        @relation(fields: [studentId], references: [id], map: "syllabuses_student_id_fkey")
  payment   Payment?
  shares    SessionShare[]
  sessions  Session[]

  @@index([studentId, createdAt, deletedAt])
  @@map("lessons")
}

enum StudentStatusValue {
  pending
  active
  paused
  leave

  @@map("StudentStatus")
}

model UserSettings {
  userId                  String   @id @map("user_id") @db.Uuid // Cognito sub 직접 참조
  use24HourFormat         Boolean  @default(false) @map("use_24_hour_format")
  defaultDuration         Int      @default(50) @map("default_duration")
  autoUpdateNextPaymentAt Boolean  @default(true) @map("auto_update_next_payment_at")
  currentOrganizationId   Int?     @map("current_organization_id")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(0)

  @@map("user_settings")
}
