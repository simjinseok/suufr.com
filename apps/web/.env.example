# ============================================
# Bunny CDN Configuration
# ============================================
# Bunny CDN base URL (Pull Zone URL)
NEXT_PUBLIC_CDN_URL=https://my-app.b-cdn.net

# ============================================
# Paddle (billing)
# ============================================
# 런타임에 서버 컴포넌트가 읽어 클라이언트로 내려줌 (빌드 타임 인라인 아님 — 재빌드 없이 변경 가능)
# Paddle 대시보드 > Developer tools > Authentication의 client-side token
PADDLE_CLIENT_TOKEN=test_xxxxxxxxxxxxxxxxxxxx
# sandbox | production
PADDLE_ENV=sandbox
# 프로 플랜 월간 price ID (Paddle 대시보드 > Catalog > Prices)
PADDLE_PRICE_ID_PRO=pri_xxxxxxxxxxxxxxxxxxxx
