# ============================================
# Runtime
# ============================================
# 운영에서는 반드시 production.
NODE_ENV=development
# 미설정 시 3000. Coolify/EB 등 플랫폼이 주입한다.
PORT=3000

# ============================================
# API 연동 (서버 전용 — 런타임 주입)
# ============================================
# apps/api 의 주소. utils/api-client.ts 가 서버에서만 읽는다.
API_URL=http://localhost:5001

# ============================================
# 빌드 타임 변수 (NEXT_PUBLIC_*)
# ============================================
# ⚠️ NEXT_PUBLIC_* 는 next build 시점에 번들로 인라인된다. 서버 라우트에서
# 쓰이더라도 마찬가지라, 컨테이너 런타임 환경변수로는 바꿀 수 없다.
# Docker 빌드 시 --build-arg 로, CodeBuild 에서는 프로젝트 환경변수로 넣는다.

# 사이트 기준 URL (robots.ts, sitemap.ts, OAuth 콜백 리다이렉트)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# CDN base URL (CloudFront / Bunny Pull Zone)
NEXT_PUBLIC_CDN_URL=https://my-app.b-cdn.net

# Sentry DSN (클라이언트 번들에 포함됨)
NEXT_PUBLIC_SENTRY_DSN=

# ============================================
# Sentry (서버 전용 — 런타임 주입)
# ============================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# 소스맵 업로드용. 빌드 타임에만 필요하며 이미지에는 남기지 않는다.
# SENTRY_AUTH_TOKEN=

# ============================================
# Paddle (billing)
# ============================================
# 런타임에 서버 컴포넌트가 읽어 클라이언트로 내려줌 (빌드 타임 인라인 아님 — 재빌드 없이 변경 가능)
# Paddle 대시보드 > Developer tools > Authentication의 client-side token
PADDLE_CLIENT_TOKEN=test_xxxxxxxxxxxxxxxxxxxx
# sandbox | production
PADDLE_ENV=sandbox
# 프로 플랜 월간 price ID (Paddle 대시보드 > Catalog > Prices)
PADDLE_PRICE_ID_PRO=pri_xxxxxxxxxxxxxxxxxxxx
