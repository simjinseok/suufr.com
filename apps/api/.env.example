# ============================================
# AWS S3 Configuration
# ============================================
# AWS region where your S3 bucket is located
AWS_REGION=ap-northeast-2

# AWS IAM credentials for S3 access
AWS_S3_ACCESS_KEY=
AWS_S3_SECRET_KEY=

# S3 bucket name for file storage
AWS_S3_BUCKET_NAME=my-app-storage-bucket

# CloudFront distribution ID for cache invalidation (optional)
# If not set, cache invalidation will be skipped
CLOUDFRONT_DISTRIBUTION_ID=E1234567890ABC

# ============================================
# CloudFront Signed Cookies/URL Configuration
# ============================================
# CloudFront distribution URL (e.g., https://dxxxxx.cloudfront.net)
CLOUDFRONT_URL=https://dxxxxx.cloudfront.net

# CloudFront key pair ID for signing (created in AWS CloudFront > Public keys)
CLOUDFRONT_KEY_PAIR_ID=KXXXXXXXXXXXXXXXX

# CloudFront private key for signing (RSA private key, PEM format)
# Use \n for newlines in the key string
CLOUDFRONT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"

# Cookie domain for CloudFront signed cookies
# Should match your CloudFront domain or custom domain (e.g., .yourdomain.com)
CLOUDFRONT_COOKIE_DOMAIN=.yourdomain.com

# CDN URL for public file access (same as CLOUDFRONT_URL or custom domain)
CDN_URL=https://dxxxxx.cloudfront.net

# ============================================
# Paddle (billing)
# ============================================
# Paddle 대시보드 > Developer tools > Authentication에서 발급한 API key
PADDLE_API_KEY=pdl_sdbx_apikey_xxxxxxxxxxxxxxxxxxxx
# Notification destination 생성 시 발급되는 webhook secret
PADDLE_WEBHOOK_SECRET=pdl_ntfset_xxxxxxxxxxxxxxxxxxxx
# sandbox | production
PADDLE_ENV=sandbox

# ============================================
# Database
# ============================================
POSTGRES_PRISMA_URL=

# ============================================
# Auth — better-auth
# ============================================
# 32바이트 이상 랜덤 문자열. JWKS 개인키 암호화·쿠키 서명에 사용. 바꾸면 발급된 세션·JWT 가 모두 무효
BETTER_AUTH_SECRET=
# api 의 공개 URL (예: https://api.example.com). JWT iss/aud 이자 better-auth baseURL
BETTER_AUTH_URL=
# web 공개 URL — better-auth trustedOrigins, 메일 링크
WEB_URL=
# ============================================
# Mail (인증코드·비밀번호 재설정 메일, Cognito 발송 대체)
# ============================================
# ses | log  (log: 콘솔 출력, 로컬용. 운영은 반드시 ses)
MAIL_TRANSPORT=log
# SES 인증 도메인/주소의 발신자
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=스프
MAIL_REPLY_TO=
# 비우면 AWS_REGION 사용
AWS_SES_REGION=
# 비우면 기본 자격증명 체인(IAM 역할 등). S3 키와 분리한 최소권한(ses:SendEmail) 사용자 권장
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ============================================
# Container (Coolify)
# ============================================
# true 면 컨테이너 시작 시 prisma migrate deploy 를 건너뛴다 (마이그레이션을 별도 단계로 돌릴 때)
SKIP_MIGRATIONS=false
