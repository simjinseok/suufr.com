generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Organization (과외방)
model Organization {
  id            Int       @id @default(autoincrement())
  uuid          String    @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  name          String // 상호명
  logoImageKey  String?   @map("logo_image_key")
  logoImageUrl  String?   @map("logo_image_url")
  phone         String? // 연락처
  address       String? // 주소 (지도용)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(0)

  // 소유자 (개인용)
  userId          String  @map("user_id") @db.Uuid
  profileName     String? @map("profile_name") // 프로필 이름
  profileImageKey String? @map("profile_image_key") // 프로필 이미지
  profileImageUrl String? @map("profile_image_url")

  students Student[]
  meetings Meeting[]

  @@index([userId, deletedAt])
  @@map("organizations")
}

model Student {
  id              Int                @id @default(autoincrement())
  uuid            String             @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  name            String
  notes           String
  status          StudentStatusValue @default(pending)
  profileImageKey String?            @map("profile_image_key")
  profileImageUrl String?            @map("profile_image_url") // CardDAV 사진 동기화용
  nextPaymentAt   DateTime?          @map("next_payment_at") @db.Date
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt       DateTime?          @map("deleted_at") @db.Timestamptz(0)
  userId          String             @map("user_id") @db.Uuid // 유지 (추후 제거)

  // 연락처 정보 (CardDAV)
  phone String?
  email String?

  // 조직
  organizationId Int          @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])

  lessons  Lesson[]
  comments StudentComment[]
  statuses StudentStatus[]

  @@index([organizationId, name, status, deletedAt])
  @@map("students")
}

model Feedback {
  id        Int       @id @default(autoincrement())
  uuid      String    @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  notes     String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(0)
  sessionId Int       @unique @map("session_id")
  session   Session   @relation(fields: [sessionId], references: [id])

  @@index([sessionId, deletedAt])
  @@map("feedback")
}

model Payment {
  id            Int       @id @default(autoincrement())
  uuid          String    @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  amount        Int
  paymentMethod String    @map("payment_method")
  notes         String?
  paidAt        DateTime  @map("paid_at") @db.Timestamptz(0)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(0)
  lessonId      Int       @unique @map("lesson_id")
  lesson        Lesson    @relation(fields: [lessonId], references: [id])

  @@index([paidAt, deletedAt, lessonId])
  @@map("payments")
}

model Meeting {
  id        Int       @id @default(autoincrement())
  uuid      String    @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String
  notes     String?
  userId    String    @map("user_id") @db.Uuid // 유지 (추후 제거)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(0)
  meetingAt DateTime  @map("meeting_at") @db.Timestamptz(0)
  isDone    Boolean   @default(false) @map("is_done")
  phone     String?

  // 조직
  organizationId Int          @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, name, isDone, deletedAt])
  @@map("meetings")
}

model StudentComment {
  id        Int       @id @default(autoincrement())
  uuid      String    @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  content   String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(0)
  studentId Int       @map("student_id")
  student   Student   @relation(fields: [studentId], references: [id])

  @@index([studentId, createdAt, deletedAt])
  @@map("student_comments")
}

model StudentStatus {
  id        Int                @id @default(autoincrement())
  uuid      String             @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  status    StudentStatusValue
  notes     String?
  changedAt DateTime           @default(now()) @map("changed_at") @db.Timestamptz(0)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt DateTime?          @map("deleted_at") @db.Timestamptz(0)
  studentId Int                @map("student_id")
  student   Student            @relation(fields: [studentId], references: [id])

  @@index([studentId, changedAt, deletedAt])
  @@map("student_statuses")
}

model SessionShare {
  id        Int       @id @default(autoincrement())
  uuid      String    @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  shareId   String    @unique @map("share_id") @db.VarChar(10)
  lessonId  Int       @map("lesson_id")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(0)
  lesson    Lesson    @relation(fields: [lessonId], references: [id])

  @@index([shareId, expiresAt, deletedAt])
  @@index([lessonId, deletedAt])
  @@map("session_shares")
}

model Session {
  id        Int       @id @default(autoincrement())
  uuid      String    @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  notes     String
  sessionAt DateTime  @map("session_at") @db.Timestamptz(0)
  duration  Int       @default(60)
  isDone    Boolean   @default(false) @map("is_done")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(0)
  lessonId  Int       @map("lesson_id")

  feedback Feedback?
  lesson   Lesson    @relation(fields: [lessonId], references: [id])

  @@index([lessonId, sessionAt, deletedAt])
  @@map("sessions")
}

model Lesson {
  id        Int       @id @default(autoincrement())
  uuid      String    @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  title     String
  notes     String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(0)
  studentId Int       @map("student_id")
  student   Student   @relation(fields: [studentId], references: [id], map: "syllabuses_student_id_fkey")

  payment  Payment?
  shares   SessionShare[]
  sessions Session[]

  @@index([studentId, createdAt, deletedAt])
  @@map("lessons")
}

enum StudentStatusValue {
  pending
  active
  paused
  leave

  @@map("StudentStatus")
}

model UserSettings {
  userId                  String   @id @map("user_id") @db.Uuid // Cognito sub 직접 참조
  use24HourFormat         Boolean  @default(false) @map("use_24_hour_format")
  defaultDuration         Int      @default(50) @map("default_duration")
  autoUpdateNextPaymentAt Boolean  @default(true) @map("auto_update_next_payment_at")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(0)

  @@map("user_settings")
}

// 앱 토큰 (CalDAV/CardDAV 인증용)
model AppToken {
  id         Int       @id @default(autoincrement())
  uuid       String    @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  name       String // "iPhone", "MacBook" 등
  tokenHash  String    @map("token_hash")
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(0)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(0)
  userId     String    @map("user_id") @db.Uuid

  @@index([userId, deletedAt])
  @@index([tokenHash, deletedAt])
  @@map("app_tokens")
}
