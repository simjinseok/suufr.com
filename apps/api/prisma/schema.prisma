generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Organization (과외방)
model Organization {
  id            Int       @id @default(autoincrement())
  uuid          String    @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  name          String // 상호명
  logoImageKey  String?   @map("logo_image_key")
  logoImageUrl  String?   @map("logo_image_url")
  phone         String? // 연락처
  address       String? // 주소 (지도용)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(0)

  // 소유자 (개인용)
  userId          String  @map("user_id") @db.Uuid
  profileName     String? @map("profile_name") // 프로필 이름
  profileImageUrl String? @map("profile_image_url")

  students    Student[]
  meetings    Meeting[]
  curriculums Curriculum[]

  @@index([userId, deletedAt])
  @@map("organizations")
}

model Student {
  id              Int                @id @default(autoincrement())
  uuid            String             @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  name            String
  notes           String
  status          StudentStatusValue @default(pending)
  profileImageUrl String?            @map("profile_image_url") // CardDAV 사진 동기화용
  nextPaymentAt   DateTime?          @map("next_payment_at") @db.Date
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt       DateTime?          @map("deleted_at") @db.Timestamptz(0)
  userId          String             @map("user_id") @db.Uuid // 유지 (추후 제거)

  // 연락처 정보 (CardDAV)
  phone String?
  email String?

  // 생일 (Google Contacts 동기화용)
  birthYear  Int? @map("birth_year")
  birthMonth Int? @map("birth_month")
  birthDay   Int? @map("birth_day")

  // 조직
  organizationId Int          @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])

  lessons       Lesson[]
  invoices      Invoice[]
  payments      Payment[]
  sessions      Session[]
  shares        StudentShare[]
  comments      StudentComment[]
  statuses      StudentStatus[]
  googleContact StudentGoogleContact?

  @@index([organizationId, name, status, deletedAt])
  @@map("students")
}

model Feedback {
  id        Int       @id @default(autoincrement())
  uuid      String    @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  notes     String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(0)
  sessionId Int       @unique @map("session_id")
  session   Session   @relation(fields: [sessionId], references: [id])

  @@index([sessionId, deletedAt])
  @@map("feedback")
}

// 청구 단위 (구 payments 테이블을 rename + 개편, docs/schema-redesign.md 참조)
model Invoice {
  id              Int              @id @default(autoincrement())
  uuid            String           @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  title           String? // 라벨 ("3월 8회권") — 구 lesson.title 승계
  price           Int // 청구액 (원). 0원도 그대로 0원 (구 "금액 미입력" 파생 상태는 §6-21에서 폐기)
  totalCount      Int?             @map("total_count") // 있으면 회차 동작(잔여 관리·명시 귀속), 없으면 기간 정액(날짜 자동 귀속)
  periodStart     DateTime?        @map("period_start") @db.Date
  periodEnd       DateTime?        @map("period_end") @db.Date
  autoRenew       Boolean          @default(false) @map("auto_renew") // cron 도입 시 사용
  renewDaysBefore Int              @default(0) @map("renew_days_before") // 마감 X일 전 사전 생성
  notes           String?
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz(0)
  studentId       Int              @map("student_id")
  student         Student          @relation(fields: [studentId], references: [id])
  lessonId        Int?             @unique @map("lesson_id") // 전환기 추적용, lessons drop 시 함께 제거
  lesson          Lesson?          @relation(fields: [lessonId], references: [id])

  sessions        Session[]
  invoicePayments InvoicePayment[]

  // NOTE: cron 멱등성용 @@unique([studentId, periodStart])는
  // 자동 생성(cron) 도입 마이그레이션에서 추가 — 백필 데이터의 우연한 충돌 방지
  @@index([studentId, deletedAt])
  @@map("invoices")
}

// 입금 1건 = 1행. 음수 = 환불.
// 학생 직속(잔액 모델) — 청구와 연결하지 않는다.
// 납부 상태는 학생 단위로 파생: 미수 = Σprice − Σ양수입금, 선납 잔액 = Σ전체입금 − Σprice
model Payment {
  id        Int       @id @default(autoincrement())
  uuid      String    @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  amount    Int
  method    String // 구 paymentMethod 승계
  paidAt    DateTime  @map("paid_at") @db.Timestamptz(0)
  notes     String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(0)
  studentId Int       @map("student_id")
  student   Student   @relation(fields: [studentId], references: [id])

  invoicePayments InvoicePayment[]

  @@index([studentId, deletedAt])
  @@index([paidAt, deletedAt])
  @@map("payments")
}

// 수강권 ↔ 입금 연결 (§6-22). 순수 연결만 — 금액 배분/파생 로직 없음.
// 연결된 미삭제 입금이 1건이라도 있으면 "입금 확인", 없으면 미납 표시.
// soft delete는 양끝(invoice/payment)의 deletedAt으로 필터 — 조인 행 자체엔 없다.
model InvoicePayment {
  id        Int      @id @default(autoincrement())
  invoiceId Int      @map("invoice_id")
  paymentId Int      @map("payment_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id])
  payment Payment @relation(fields: [paymentId], references: [id])

  @@unique([invoiceId, paymentId])
  @@index([paymentId])
  @@map("invoice_payments")
}

model Meeting {
  id        Int       @id @default(autoincrement())
  uuid      String    @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String
  notes     String?
  userId    String    @map("user_id") @db.Uuid // 유지 (추후 제거)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(0)
  meetingAt DateTime  @map("meeting_at") @db.Timestamptz(0)
  isDone    Boolean   @default(false) @map("is_done")
  phone     String?

  // 조직
  organizationId Int          @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, name, isDone, deletedAt])
  @@map("meetings")
}

model StudentComment {
  id        Int       @id @default(autoincrement())
  uuid      String    @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  content   String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(0)
  studentId Int       @map("student_id")
  student   Student   @relation(fields: [studentId], references: [id])

  @@index([studentId, createdAt, deletedAt])
  @@map("student_comments")
}

model StudentStatus {
  id        Int                @id @default(autoincrement())
  uuid      String             @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  status    StudentStatusValue
  notes     String?
  changedAt DateTime           @default(now()) @map("changed_at") @db.Timestamptz(0)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt DateTime?          @map("deleted_at") @db.Timestamptz(0)
  studentId Int                @map("student_id")
  student   Student            @relation(fields: [studentId], references: [id])

  @@index([studentId, changedAt, deletedAt])
  @@map("student_statuses")
}

model LessonShare {
  id        Int       @id @default(autoincrement())
  uuid      String    @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  shareId   String    @unique @map("share_id") @db.VarChar(10)
  lessonId  Int       @map("lesson_id")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(0)
  lesson    Lesson    @relation(fields: [lessonId], references: [id])

  @@index([shareId, expiresAt, deletedAt])
  @@index([lessonId, deletedAt])
  @@map("lesson_shares")
}

model Session {
  id        Int              @id @default(autoincrement())
  uuid      String           @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  notes     String
  sessionAt DateTime         @map("session_at") @db.Timestamptz(0)
  duration  Int              @default(60)
  isDone    Boolean          @default(false) @map("is_done")
  type      SessionTypeValue @default(regular) // trial/comp는 미연결 알림에서 제외
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt DateTime?        @map("deleted_at") @db.Timestamptz(0)
  studentId Int              @map("student_id")
  invoiceId Int?             @map("invoice_id") // 청구 귀속, nullable
  lessonId  Int?             @map("lesson_id") // 전환기 추적용, lessons drop 시 함께 제거

  feedback          Feedback?
  student           Student             @relation(fields: [studentId], references: [id])
  invoice           Invoice?            @relation(fields: [invoiceId], references: [id])
  lesson            Lesson?             @relation(fields: [lessonId], references: [id])
  googleEvent       SessionGoogleEvent?
  sessionMediaFiles SessionMediaFile[]

  @@index([studentId, sessionAt, deletedAt])
  @@index([invoiceId])
  @@map("sessions")
}

model Lesson {
  id        Int       @id @default(autoincrement())
  uuid      String    @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  title     String
  notes     String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(0)
  studentId Int       @map("student_id")
  student   Student   @relation(fields: [studentId], references: [id], map: "syllabuses_student_id_fkey")

  invoice  Invoice?
  shares   LessonShare[]
  sessions Session[]

  @@index([studentId, createdAt, deletedAt])
  @@map("lessons")
}

// 학생 단위 공유 (LessonShare 대체)
model StudentShare {
  id           Int       @id @default(autoincrement())
  uuid         String    @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  shareId      String    @unique @map("share_id") @db.VarChar(10)
  showPayments Boolean   @default(true) @map("show_payments") // 결제 섹션(예정일·납부상태) 노출 토글
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(0)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(0)
  studentId    Int       @map("student_id")
  student      Student   @relation(fields: [studentId], references: [id])

  @@index([shareId, expiresAt, deletedAt])
  @@index([studentId, deletedAt])
  @@map("student_shares")
}

enum StudentStatusValue {
  pending
  active
  paused
  leave

  @@map("StudentStatus")
}

enum SessionTypeValue {
  regular // 정규 유료 수업
  trial // 체험
  comp // 무료 서비스

  @@map("SessionType")
}

model UserSettings {
  userId                  String   @id @map("user_id") @db.Uuid // users.id (FK 없음)
  use24HourFormat         Boolean  @default(false) @map("use_24_hour_format")
  defaultDuration         Int      @default(50) @map("default_duration")
  autoUpdateNextPaymentAt Boolean  @default(true) @map("auto_update_next_payment_at")
  timezone                String? // IANA 타임존. null = 미설정(웹 첫 방문 시 브라우저 값으로 자동 초기화)
  defaultPaymentMethod    String   @default("transfer") @map("default_payment_method") // 새 입금 폼 초기 선택값. transfer | card | cash (검증은 DTO)
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(0)

  @@map("user_settings")
}

// 앱 토큰 (CalDAV/CardDAV 인증용)
model AppToken {
  id         Int       @id @default(autoincrement())
  uuid       String    @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  name       String // "iPhone", "MacBook" 등
  tokenHash  String    @map("token_hash")
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(0)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(0)
  userId     String    @map("user_id") @db.Uuid

  @@index([userId, deletedAt])
  @@index([tokenHash, deletedAt])
  @@map("app_tokens")
}

// 외부 서비스 OAuth 토큰 (Google 등)
model ExternalServiceToken {
  id             Int       @id @default(autoincrement())
  uuid           String    @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  provider       String // "google"
  accessToken    String    @map("access_token") @db.Text // AES-256 암호화
  refreshToken   String?   @map("refresh_token") @db.Text // AES-256 암호화
  tokenExpiresAt DateTime? @map("token_expires_at") @db.Timestamptz(0)
  scope          String?
  providerUserId String?   @map("provider_user_id")
  providerEmail  String?   @map("provider_email")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(0)
  userId         String    @map("user_id") @db.Uuid

  @@unique([userId, provider])
  @@index([provider, deletedAt])
  @@map("external_service_tokens")
}

// 사용자별 Google 동기화 토큰 (전체 동기화용)
model GoogleSyncToken {
  id                 Int       @id @default(autoincrement())
  calendarSyncToken  String?   @map("calendar_sync_token") // Calendar API syncToken
  calendarId         String?   @map("calendar_id") // 동기화할 캘린더 ID
  contactsSyncToken  String?   @map("contacts_sync_token") // People API syncToken
  lastCalendarSyncAt DateTime? @map("last_calendar_sync_at") @db.Timestamptz(0)
  lastContactsSyncAt DateTime? @map("last_contacts_sync_at") @db.Timestamptz(0)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(0)
  userId             String    @unique @map("user_id") @db.Uuid

  // Google Calendar Webhook
  webhookChannelId  String?   @map("webhook_channel_id")
  webhookResourceId String?   @map("webhook_resource_id")
  webhookExpiration DateTime? @map("webhook_expiration") @db.Timestamptz(0)

  @@map("google_sync_tokens")
}

// Session ↔ Google Calendar Event 매핑
model SessionGoogleEvent {
  id               Int       @id @default(autoincrement())
  googleEventId    String    @map("google_event_id") // Google Event ID
  googleCalendarId String    @map("google_calendar_id") // 어느 캘린더에 저장됐는지
  etag             String? // 변경 감지용
  lastSyncedAt     DateTime? @map("last_synced_at") @db.Timestamptz(0)
  syncStatus       String    @default("synced") @map("sync_status") // synced, pending, error
  errorMessage     String?   @map("error_message")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(0)
  sessionId        Int       @unique @map("session_id")
  userId           String    @map("user_id") @db.Uuid

  session Session @relation(fields: [sessionId], references: [id])

  @@index([googleEventId])
  @@index([userId, syncStatus])
  @@map("session_google_events")
}

// Student ↔ Google Contact 매핑
model StudentGoogleContact {
  id                 Int       @id @default(autoincrement())
  googleResourceName String    @map("google_resource_name") // "people/c1234567890"
  etag               String? // 변경 감지용
  lastSyncedAt       DateTime? @map("last_synced_at") @db.Timestamptz(0)
  syncStatus         String    @default("synced") @map("sync_status") // synced, pending, error
  errorMessage       String?   @map("error_message")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(0)
  studentId          Int       @unique @map("student_id")
  userId             String    @map("user_id") @db.Uuid

  student Student @relation(fields: [studentId], references: [id])

  @@index([googleResourceName])
  @@index([userId, syncStatus])
  @@map("student_google_contacts")
}

// 폴더 (파일 정리용)
model Folder {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String   @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(0)
  userId    String   @map("user_id") @db.Uuid

  // 중첩 폴더
  parentId Int?     @map("parent_id")
  parent   Folder?  @relation("FolderHierarchy", fields: [parentId], references: [id])
  children Folder[] @relation("FolderHierarchy")

  mediaFiles MediaFile[]

  @@index([userId])
  @@index([parentId])
  @@map("folders")
}

// 미디어 파일 (이미지/동영상)
model MediaFile {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  url       String
  publicId  String   @map("public_id")
  type      String // "image" | "video"
  fileName  String?  @map("file_name")
  fileSize  Int      @map("file_size") // 바이트 단위 (용량 계산용)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(0)
  userId    String   @map("user_id") @db.Uuid // 소유자 (용량 관리용)

  // 폴더
  folderId Int?    @map("folder_id")
  folder   Folder? @relation(fields: [folderId], references: [id])

  sessionMediaFiles        SessionMediaFile[]
  curriculumItemMediaFiles CurriculumItemMediaFile[]

  @@index([userId])
  @@index([userId, fileName])
  @@index([userId, folderId])
  @@map("media_files")
}

// 세션 ↔ 미디어 파일 연결 테이블
model SessionMediaFile {
  id          Int      @id @default(autoincrement())
  sessionId   Int      @map("session_id")
  mediaFileId Int      @map("media_file_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(0)

  session   Session   @relation(fields: [sessionId], references: [id])
  mediaFile MediaFile @relation(fields: [mediaFileId], references: [id])

  @@unique([sessionId, mediaFileId])
  @@index([sessionId])
  @@map("session_media_files")
}

// 사용자 스토리지 용량 관리
model UserStorageQuota {
  userId    String   @id @map("user_id") @db.Uuid
  usedBytes BigInt   @default(0) @map("used_bytes") // 현재 사용량
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(0)

  @@map("user_storage_quotas")
}

// 커리큘럼 (수업 계획)
model Curriculum {
  id             Int       @id @default(autoincrement())
  uuid           String    @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  title          String
  description    String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(0)
  organizationId Int       @map("organization_id")

  organization Organization     @relation(fields: [organizationId], references: [id])
  items        CurriculumItem[]

  @@index([organizationId, deletedAt])
  @@map("curriculums")
}

// 커리큘럼 아이템
model CurriculumItem {
  id           Int       @id @default(autoincrement())
  uuid         String    @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  title        String
  description  String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(0)
  curriculumId Int       @map("curriculum_id")

  curriculum Curriculum                @relation(fields: [curriculumId], references: [id])
  mediaFiles CurriculumItemMediaFile[]

  @@index([curriculumId, deletedAt])
  @@map("curriculum_items")
}

// 커리큘럼 아이템 ↔ 미디어 파일 연결 테이블
model CurriculumItemMediaFile {
  id               Int      @id @default(autoincrement())
  curriculumItemId Int      @map("curriculum_item_id")
  mediaFileId      Int      @map("media_file_id")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(0)

  curriculumItem CurriculumItem @relation(fields: [curriculumItemId], references: [id])
  mediaFile      MediaFile      @relation(fields: [mediaFileId], references: [id])

  @@unique([curriculumItemId, mediaFileId])
  @@index([curriculumItemId])
  @@map("curriculum_item_media_files")
}

// 결제 provider 열거형. 설계: docs/superpowers/specs/2026-10-06-billing-provider-neutral-schema-design.md
enum BillingProviderValue {
  paddle
  apple
  google
  manual // 수동 부여 (currentPeriodEnd null = 무기한)

  @@map("BillingProvider")
}

enum BillingEnvironmentValue {
  production
  sandbox

  @@map("BillingEnvironment")
}

// 현재 기간(구독 행) 또는 해당 거래(주문 행)의 종류
// Apple offerType / Google offerPhase / Paddle trialing 이 여기로 매핑된다
enum BillingPeriodTypeValue {
  normal
  trial
  intro
  promotional

  @@map("BillingPeriodType")
}

// 사용자 구독 (행이 없으면 free 플랜). 계정당 1행, 한 시점에 한 provider
// 결제 provider(Paddle / App Store / Google Play)가 청구 주체이며 webhook 으로 동기화되는 캐시. 진실의 원천은 provider 의 구독 엔티티
// providerSubscriptionId: Paddle sub_…, Apple originalTransactionId, Google purchaseToken, manual 은 null
model UserSubscription {
  userId                 String                   @id @map("user_id") @db.Uuid // users.id (FK 없음)
  plan                   PlanValue                @default(free)
  status                 SubscriptionStatusValue  @default(active)
  currentPeriodStart     DateTime?                @map("current_period_start") @db.Timestamptz(0)
  currentPeriodEnd       DateTime?                @map("current_period_end") @db.Timestamptz(0) // null = 무기한 (manual)
  gracePeriodExpiresAt   DateTime?                @map("grace_period_expires_at") @db.Timestamptz(0) // 결제 실패 후 접근이 유지되는 유예 만료. 유효 플랜 판정이 currentPeriodEnd 와 max 로 본다
  canceledAt             DateTime?                @map("canceled_at") @db.Timestamptz(0)
  billingIssueDetectedAt DateTime?                @map("billing_issue_detected_at") @db.Timestamptz(0) // past_due 진입 시각. past_due 가 아니면 null
  periodType             BillingPeriodTypeValue   @default(normal) @map("period_type")
  provider               BillingProviderValue
  providerEnvironment    BillingEnvironmentValue? @map("provider_environment") // 리네임 이전 행은 null
  providerCustomerId     String?                  @map("provider_customer_id") // Paddle ctm_…. Apple·Google 은 null
  providerSubscriptionId String?                  @map("provider_subscription_id")
  providerProductId      String?                  @map("provider_product_id") // Paddle price id, Apple productId, Google productId:basePlanId
  providerNextProductId  String?                  @map("provider_next_product_id") // 다음 기간부터 적용될 상품 (다운그레이드 예약)
  providerLastEventAt    DateTime?                @map("provider_last_event_at") @db.Timestamptz(3) // 마지막으로 반영한 이벤트 시각 (순서 역전 가드). 밀리초 보존 — (0) 이면 반올림으로 같은 초의 늦은 이벤트가 스킵된다
  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt              DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(0)

  @@unique([provider, providerSubscriptionId])
  @@map("user_subscriptions")
}

enum PlanValue {
  free
  pro

  @@map("Plan")
}

enum SubscriptionStatusValue {
  active
  canceled
  past_due
  expired

  @@map("SubscriptionStatus")
}

// 구독 결제 시도 기록 (결제 내역/감사용)
// 같은 거래가 실패 후 성공할 수 있으므로 (provider, providerTransactionId) 기준 upsert
// amount·refundedAmount 는 통화 최소 단위 정수 (KRW 6,900원 = 6900)
// 인보이스 URL 은 발급 후 1시간 만료라 저장하지 않고 온디맨드로 발급 (paddle 만)
model SubscriptionOrder {
  id                    Int                          @id @default(autoincrement())
  userId                String                       @map("user_id") @db.Uuid // users.id (FK 없음)
  provider              BillingProviderValue
  providerTransactionId String                       @map("provider_transaction_id") // Paddle txn_…, Apple transactionId, Google orderId
  providerEnvironment   BillingEnvironmentValue?     @map("provider_environment")
  amount                Int
  currency              String                       @db.VarChar(3) // ISO 4217
  periodType            BillingPeriodTypeValue       @default(normal) @map("period_type")
  periodStart           DateTime?                    @map("period_start") @db.Timestamptz(0)
  periodEnd             DateTime?                    @map("period_end") @db.Timestamptz(0)
  status                SubscriptionOrderStatusValue
  failReason            String?                      @map("fail_reason")
  approvedAt            DateTime?                    @map("approved_at") @db.Timestamptz(0)
  refundedAt            DateTime?                    @map("refunded_at") @db.Timestamptz(0)
  refundedAmount        Int?                         @map("refunded_amount") // 부분 환불 가능 (환불정책 2조). 전액이면 amount 와 같다
  createdAt             DateTime                     @default(now()) @map("created_at") @db.Timestamptz(0)

  @@unique([provider, providerTransactionId])
  @@index([userId, createdAt])
  @@map("subscription_orders")
}

enum SubscriptionOrderStatusValue {
  done
  failed
  refunded // 마지막 값 유지 — ALTER TYPE ADD VALUE 는 끝에 붙는다

  @@map("SubscriptionOrderStatus")
}

// 처리한 결제 webhook 이벤트 ((provider, eventId) 기반 멱등성 보장용)
// eventId: Paddle event_id, Apple notificationUUID, Google Pub/Sub messageId
// payload: 장애 분석·재처리용 원문 (raw body 를 파싱한 JSON). 리네임 이전 행은 null
model BillingWebhookEvent {
  provider   BillingProviderValue
  eventId    String               @map("event_id")
  eventType  String               @map("event_type")
  occurredAt DateTime             @map("occurred_at") @db.Timestamptz(3)
  payload    Json?
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(0)

  @@id([provider, eventId])
  @@map("billing_webhook_events")
}

// 약관·개인정보 동의 이력 (추가 전용, 수정·삭제하지 않음)
// userId = users.id. 가입 직후(AuthController.signup) 기록되므로 이메일 미인증 상태에서도 행이 존재한다.
// 철회는 agreed=false 행을 추가한다. 재동의 필요 여부는 타입별 최신 행의 docVersion 을 common/constants/legal.ts 와 비교해 판단.
model UserConsent {
  id          Int              @id @default(autoincrement())
  userId      String           @map("user_id") @db.Uuid
  type        ConsentTypeValue
  docVersion  String           @map("doc_version") // 동의한 문서 시행일 'YYYY-MM-DD'
  agreed      Boolean          @default(true)
  ipAddress   String?          @map("ip_address") @db.VarChar(45) // IPv6 최대 45자
  userAgent   String?          @map("user_agent") @db.VarChar(512)
  consentedAt DateTime         @default(now()) @map("consented_at") @db.Timestamptz(0)

  @@index([userId, type, consentedAt])
  @@map("user_consents")
}

enum ConsentTypeValue {
  terms
  privacy
  overseas_transfer

  @@map("ConsentType")
}

// better-auth 사용자. id 는 uuid v4. 2026-10 better-auth 이전 전에 가입한 사용자의 id 는 당시 Cognito 사용자 풀의 sub(uuid 형식)를 그대로 쓴다.
// Organization/UserSettings 등 기존 테이블의 user_id 가 이 id 를 가리킨다 (FK 는 추가하지 않음 — 삭제된 사용자 잔존 데이터 허용).
model User {
  id                     String    @id @db.Uuid
  name                   String
  email                  String    @unique // 소문자 정규화 (better-auth 조회 기준)
  emailVerified          Boolean   @default(false) @map("email_verified")
  image                  String?
  twoFactorEnabled       Boolean?  @map("two_factor_enabled") // better-auth twoFactor 플러그인
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(0)

  sessions   AuthSession[]
  accounts   Account[]
  twoFactors TwoFactor[]

  @@map("users")
}

// better-auth 세션. 기존 수업 모델 Session(sessions) 과 충돌하므로 이름을 바꿈 — auth.config.ts 의 session.modelName: 'authSession'
model AuthSession {
  id        String   @id @db.Uuid
  token     String   @unique
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(0)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(0)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

// better-auth 인증 수단. providerId = 'credential'(이메일+비밀번호, password 에 scrypt 해시) | 추후 'google' 등
model Account {
  id                    String    @id @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(0)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(0)
  scope                 String?
  idToken               String?   @map("id_token")
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(0)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

// better-auth 검증 토큰/OTP 저장 (이메일 인증 OTP, 비밀번호 재설정 OTP)
model Verification {
  id         String   @id @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(0)

  @@index([identifier])
  @@map("verifications")
}

// better-auth JWT 플러그인 서명 키 (private_key 는 BETTER_AUTH_SECRET 으로 AES-256-GCM 암호화됨)
model Jwks {
  id         String    @id @db.Uuid
  publicKey  String    @map("public_key")
  privateKey String    @map("private_key")
  alg        String? // 서명 알고리즘 (기본 EdDSA)
  crv        String? // 곡선 (EdDSA: Ed25519)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(0)

  @@map("jwks")
}

// better-auth twoFactor 플러그인 (TOTP 시드·백업코드)
model TwoFactor {
  id                      String    @id @db.Uuid
  userId                  String    @map("user_id") @db.Uuid
  secret                  String
  backupCodes             String    @map("backup_codes")
  verified                Boolean   @default(false)
  failedVerificationCount Int       @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz(0)
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factors")
}
