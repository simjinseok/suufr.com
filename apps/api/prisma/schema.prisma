generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Organization (과외방)
model Organization {
  id            Int       @id @default(autoincrement())
  uuid          String    @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  name          String // 상호명
  logoImageKey  String?   @map("logo_image_key")
  logoImageUrl  String?   @map("logo_image_url")
  phone         String? // 연락처
  address       String? // 주소 (지도용)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(0)

  // 소유자 (개인용)
  userId          String  @map("user_id") @db.Uuid
  profileName     String? @map("profile_name") // 프로필 이름
  profileImageUrl String? @map("profile_image_url")

  students    Student[]
  meetings    Meeting[]
  curriculums Curriculum[]

  @@index([userId, deletedAt])
  @@map("organizations")
}

model Student {
  id              Int                @id @default(autoincrement())
  uuid            String             @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  name            String
  notes           String
  status          StudentStatusValue @default(pending)
  profileImageUrl String?            @map("profile_image_url") // CardDAV 사진 동기화용
  nextPaymentAt   DateTime?          @map("next_payment_at") @db.Date
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt       DateTime?          @map("deleted_at") @db.Timestamptz(0)
  userId          String             @map("user_id") @db.Uuid // 유지 (추후 제거)

  // 연락처 정보 (CardDAV)
  phone String?
  email String?

  // 생일 (Google Contacts 동기화용)
  birthYear  Int? @map("birth_year")
  birthMonth Int? @map("birth_month")
  birthDay   Int? @map("birth_day")

  // 조직
  organizationId Int          @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])

  lessons       Lesson[]
  invoices      Invoice[]
  payments      Payment[]
  sessions      Session[]
  shares        StudentShare[]
  comments      StudentComment[]
  statuses      StudentStatus[]
  googleContact StudentGoogleContact?

  @@index([organizationId, name, status, deletedAt])
  @@map("students")
}

model Feedback {
  id        Int       @id @default(autoincrement())
  uuid      String    @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  notes     String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(0)
  sessionId Int       @unique @map("session_id")
  session   Session   @relation(fields: [sessionId], references: [id])

  @@index([sessionId, deletedAt])
  @@map("feedback")
}

// 청구 단위 (구 payments 테이블을 rename + 개편, docs/schema-redesign.md 참조)
model Invoice {
  id              Int              @id @default(autoincrement())
  uuid            String           @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  title           String? // 라벨 ("3월 8회권") — 구 lesson.title 승계
  price           Int // 청구액 (원). 0원도 그대로 0원 (구 "금액 미입력" 파생 상태는 §6-21에서 폐기)
  totalCount      Int?             @map("total_count") // 있으면 회차 동작(잔여 관리·명시 귀속), 없으면 기간 정액(날짜 자동 귀속)
  periodStart     DateTime?        @map("period_start") @db.Date
  periodEnd       DateTime?        @map("period_end") @db.Date
  autoRenew       Boolean          @default(false) @map("auto_renew") // cron 도입 시 사용
  renewDaysBefore Int              @default(0) @map("renew_days_before") // 마감 X일 전 사전 생성
  notes           String?
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz(0)
  studentId       Int              @map("student_id")
  student         Student          @relation(fields: [studentId], references: [id])
  lessonId        Int?             @unique @map("lesson_id") // 전환기 추적용, lessons drop 시 함께 제거
  lesson          Lesson?          @relation(fields: [lessonId], references: [id])

  sessions Session[]

  // NOTE: cron 멱등성용 @@unique([studentId, periodStart])는
  // 자동 생성(cron) 도입 마이그레이션에서 추가 — 백필 데이터의 우연한 충돌 방지
  @@index([studentId, deletedAt])
  @@map("invoices")
}

// 입금 1건 = 1행. 음수 = 환불.
// 학생 직속(잔액 모델) — 청구와 연결하지 않는다.
// 납부 상태는 학생 단위로 파생: 미수 = Σprice − Σ양수입금, 선납 잔액 = Σ전체입금 − Σprice
model Payment {
  id        Int       @id @default(autoincrement())
  uuid      String    @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  amount    Int
  method    String // 구 paymentMethod 승계
  paidAt    DateTime  @map("paid_at") @db.Timestamptz(0)
  notes     String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(0)
  studentId Int       @map("student_id")
  student   Student   @relation(fields: [studentId], references: [id])

  @@index([studentId, deletedAt])
  @@index([paidAt, deletedAt])
  @@map("payments")
}

model Meeting {
  id        Int       @id @default(autoincrement())
  uuid      String    @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String
  notes     String?
  userId    String    @map("user_id") @db.Uuid // 유지 (추후 제거)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(0)
  meetingAt DateTime  @map("meeting_at") @db.Timestamptz(0)
  isDone    Boolean   @default(false) @map("is_done")
  phone     String?

  // 조직
  organizationId Int          @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, name, isDone, deletedAt])
  @@map("meetings")
}

model StudentComment {
  id        Int       @id @default(autoincrement())
  uuid      String    @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  content   String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(0)
  studentId Int       @map("student_id")
  student   Student   @relation(fields: [studentId], references: [id])

  @@index([studentId, createdAt, deletedAt])
  @@map("student_comments")
}

model StudentStatus {
  id        Int                @id @default(autoincrement())
  uuid      String             @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  status    StudentStatusValue
  notes     String?
  changedAt DateTime           @default(now()) @map("changed_at") @db.Timestamptz(0)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt DateTime?          @map("deleted_at") @db.Timestamptz(0)
  studentId Int                @map("student_id")
  student   Student            @relation(fields: [studentId], references: [id])

  @@index([studentId, changedAt, deletedAt])
  @@map("student_statuses")
}

model LessonShare {
  id        Int       @id @default(autoincrement())
  uuid      String    @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  shareId   String    @unique @map("share_id") @db.VarChar(10)
  lessonId  Int       @map("lesson_id")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(0)
  lesson    Lesson    @relation(fields: [lessonId], references: [id])

  @@index([shareId, expiresAt, deletedAt])
  @@index([lessonId, deletedAt])
  @@map("lesson_shares")
}

model Session {
  id        Int              @id @default(autoincrement())
  uuid      String           @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  notes     String
  sessionAt DateTime         @map("session_at") @db.Timestamptz(0)
  duration  Int              @default(60)
  isDone    Boolean          @default(false) @map("is_done")
  type      SessionTypeValue @default(regular) // trial/comp는 미연결 알림에서 제외
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt DateTime?        @map("deleted_at") @db.Timestamptz(0)
  studentId Int              @map("student_id")
  invoiceId Int?             @map("invoice_id") // 청구 귀속, nullable
  lessonId  Int?             @map("lesson_id") // 전환기 추적용, lessons drop 시 함께 제거

  feedback          Feedback?
  student           Student             @relation(fields: [studentId], references: [id])
  invoice           Invoice?            @relation(fields: [invoiceId], references: [id])
  lesson            Lesson?             @relation(fields: [lessonId], references: [id])
  googleEvent       SessionGoogleEvent?
  sessionMediaFiles SessionMediaFile[]

  @@index([studentId, sessionAt, deletedAt])
  @@index([invoiceId])
  @@map("sessions")
}

model Lesson {
  id        Int       @id @default(autoincrement())
  uuid      String    @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  title     String
  notes     String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(0)
  studentId Int       @map("student_id")
  student   Student   @relation(fields: [studentId], references: [id], map: "syllabuses_student_id_fkey")

  invoice  Invoice?
  shares   LessonShare[]
  sessions Session[]

  @@index([studentId, createdAt, deletedAt])
  @@map("lessons")
}

// 학생 단위 공유 (LessonShare 대체)
model StudentShare {
  id           Int       @id @default(autoincrement())
  uuid         String    @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  shareId      String    @unique @map("share_id") @db.VarChar(10)
  showPayments Boolean   @default(true) @map("show_payments") // 결제 섹션(예정일·납부상태) 노출 토글
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(0)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(0)
  studentId    Int       @map("student_id")
  student      Student   @relation(fields: [studentId], references: [id])

  @@index([shareId, expiresAt, deletedAt])
  @@index([studentId, deletedAt])
  @@map("student_shares")
}

enum StudentStatusValue {
  pending
  active
  paused
  leave

  @@map("StudentStatus")
}

enum SessionTypeValue {
  regular // 정규 유료 수업
  trial // 체험
  comp // 무료 서비스

  @@map("SessionType")
}

model UserSettings {
  userId                  String   @id @map("user_id") @db.Uuid // Cognito sub 직접 참조
  use24HourFormat         Boolean  @default(false) @map("use_24_hour_format")
  defaultDuration         Int      @default(50) @map("default_duration")
  autoUpdateNextPaymentAt Boolean  @default(true) @map("auto_update_next_payment_at")
  timezone                String? // IANA 타임존. null = 미설정(웹 첫 방문 시 브라우저 값으로 자동 초기화)
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(0)

  @@map("user_settings")
}

// 앱 토큰 (CalDAV/CardDAV 인증용)
model AppToken {
  id         Int       @id @default(autoincrement())
  uuid       String    @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  name       String // "iPhone", "MacBook" 등
  tokenHash  String    @map("token_hash")
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(0)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(0)
  userId     String    @map("user_id") @db.Uuid

  @@index([userId, deletedAt])
  @@index([tokenHash, deletedAt])
  @@map("app_tokens")
}

// 외부 서비스 OAuth 토큰 (Google 등)
model ExternalServiceToken {
  id             Int       @id @default(autoincrement())
  uuid           String    @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  provider       String // "google"
  accessToken    String    @map("access_token") @db.Text // AES-256 암호화
  refreshToken   String?   @map("refresh_token") @db.Text // AES-256 암호화
  tokenExpiresAt DateTime? @map("token_expires_at") @db.Timestamptz(0)
  scope          String?
  providerUserId String?   @map("provider_user_id")
  providerEmail  String?   @map("provider_email")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(0)
  userId         String    @map("user_id") @db.Uuid

  @@unique([userId, provider])
  @@index([provider, deletedAt])
  @@map("external_service_tokens")
}

// 사용자별 Google 동기화 토큰 (전체 동기화용)
model GoogleSyncToken {
  id                 Int       @id @default(autoincrement())
  calendarSyncToken  String?   @map("calendar_sync_token") // Calendar API syncToken
  calendarId         String?   @map("calendar_id") // 동기화할 캘린더 ID
  contactsSyncToken  String?   @map("contacts_sync_token") // People API syncToken
  lastCalendarSyncAt DateTime? @map("last_calendar_sync_at") @db.Timestamptz(0)
  lastContactsSyncAt DateTime? @map("last_contacts_sync_at") @db.Timestamptz(0)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(0)
  userId             String    @unique @map("user_id") @db.Uuid

  // Google Calendar Webhook
  webhookChannelId  String?   @map("webhook_channel_id")
  webhookResourceId String?   @map("webhook_resource_id")
  webhookExpiration DateTime? @map("webhook_expiration") @db.Timestamptz(0)

  @@map("google_sync_tokens")
}

// Session ↔ Google Calendar Event 매핑
model SessionGoogleEvent {
  id               Int       @id @default(autoincrement())
  googleEventId    String    @map("google_event_id") // Google Event ID
  googleCalendarId String    @map("google_calendar_id") // 어느 캘린더에 저장됐는지
  etag             String? // 변경 감지용
  lastSyncedAt     DateTime? @map("last_synced_at") @db.Timestamptz(0)
  syncStatus       String    @default("synced") @map("sync_status") // synced, pending, error
  errorMessage     String?   @map("error_message")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(0)
  sessionId        Int       @unique @map("session_id")
  userId           String    @map("user_id") @db.Uuid

  session Session @relation(fields: [sessionId], references: [id])

  @@index([googleEventId])
  @@index([userId, syncStatus])
  @@map("session_google_events")
}

// Student ↔ Google Contact 매핑
model StudentGoogleContact {
  id                 Int       @id @default(autoincrement())
  googleResourceName String    @map("google_resource_name") // "people/c1234567890"
  etag               String? // 변경 감지용
  lastSyncedAt       DateTime? @map("last_synced_at") @db.Timestamptz(0)
  syncStatus         String    @default("synced") @map("sync_status") // synced, pending, error
  errorMessage       String?   @map("error_message")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(0)
  studentId          Int       @unique @map("student_id")
  userId             String    @map("user_id") @db.Uuid

  student Student @relation(fields: [studentId], references: [id])

  @@index([googleResourceName])
  @@index([userId, syncStatus])
  @@map("student_google_contacts")
}

// 폴더 (파일 정리용)
model Folder {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String   @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(0)
  userId    String   @map("user_id") @db.Uuid

  // 중첩 폴더
  parentId Int?     @map("parent_id")
  parent   Folder?  @relation("FolderHierarchy", fields: [parentId], references: [id])
  children Folder[] @relation("FolderHierarchy")

  mediaFiles MediaFile[]

  @@index([userId])
  @@index([parentId])
  @@map("folders")
}

// 미디어 파일 (이미지/동영상)
model MediaFile {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  url       String
  publicId  String   @map("public_id")
  type      String // "image" | "video"
  fileName  String?  @map("file_name")
  fileSize  Int      @map("file_size") // 바이트 단위 (용량 계산용)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(0)
  userId    String   @map("user_id") @db.Uuid // 소유자 (용량 관리용)

  // 폴더
  folderId Int?    @map("folder_id")
  folder   Folder? @relation(fields: [folderId], references: [id])

  sessionMediaFiles        SessionMediaFile[]
  curriculumItemMediaFiles CurriculumItemMediaFile[]

  @@index([userId])
  @@index([userId, fileName])
  @@index([userId, folderId])
  @@map("media_files")
}

// 세션 ↔ 미디어 파일 연결 테이블
model SessionMediaFile {
  id          Int      @id @default(autoincrement())
  sessionId   Int      @map("session_id")
  mediaFileId Int      @map("media_file_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(0)

  session   Session   @relation(fields: [sessionId], references: [id])
  mediaFile MediaFile @relation(fields: [mediaFileId], references: [id])

  @@unique([sessionId, mediaFileId])
  @@index([sessionId])
  @@map("session_media_files")
}

// 사용자 스토리지 용량 관리
model UserStorageQuota {
  userId    String   @id @map("user_id") @db.Uuid
  usedBytes BigInt   @default(0) @map("used_bytes") // 현재 사용량
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(0)

  @@map("user_storage_quotas")
}

// 커리큘럼 (수업 계획)
model Curriculum {
  id             Int       @id @default(autoincrement())
  uuid           String    @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  title          String
  description    String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(0)
  organizationId Int       @map("organization_id")

  organization Organization     @relation(fields: [organizationId], references: [id])
  items        CurriculumItem[]

  @@index([organizationId, deletedAt])
  @@map("curriculums")
}

// 커리큘럼 아이템
model CurriculumItem {
  id           Int       @id @default(autoincrement())
  uuid         String    @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  title        String
  description  String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(0)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(0)
  curriculumId Int       @map("curriculum_id")

  curriculum Curriculum                @relation(fields: [curriculumId], references: [id])
  mediaFiles CurriculumItemMediaFile[]

  @@index([curriculumId, deletedAt])
  @@map("curriculum_items")
}

// 커리큘럼 아이템 ↔ 미디어 파일 연결 테이블
model CurriculumItemMediaFile {
  id               Int      @id @default(autoincrement())
  curriculumItemId Int      @map("curriculum_item_id")
  mediaFileId      Int      @map("media_file_id")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(0)

  curriculumItem CurriculumItem @relation(fields: [curriculumItemId], references: [id])
  mediaFile      MediaFile      @relation(fields: [mediaFileId], references: [id])

  @@unique([curriculumItemId, mediaFileId])
  @@index([curriculumItemId])
  @@map("curriculum_item_media_files")
}

// 사용자 구독 (행이 없으면 free 플랜)
// Paddle이 청구 주체이며 webhook으로 동기화되는 캐시. 진실의 원천은 Paddle 구독 엔티티
model UserSubscription {
  userId               String                  @id @map("user_id") @db.Uuid // Cognito sub 직접 참조
  plan                 PlanValue               @default(free)
  status               SubscriptionStatusValue @default(active)
  currentPeriodStart   DateTime?               @map("current_period_start") @db.Timestamptz(0)
  currentPeriodEnd     DateTime?               @map("current_period_end") @db.Timestamptz(0) // null = 무기한 (수동 부여)
  canceledAt           DateTime?               @map("canceled_at") @db.Timestamptz(0)
  paddleCustomerId     String?                 @map("paddle_customer_id")
  paddleSubscriptionId String?                 @unique @map("paddle_subscription_id")
  paddleLastEventAt    DateTime?               @map("paddle_last_event_at") @db.Timestamptz(0) // 마지막으로 반영한 webhook의 occurred_at (순서 역전 가드)
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt            DateTime                @updatedAt @map("updated_at") @db.Timestamptz(0)

  @@map("user_subscriptions")
}

enum PlanValue {
  free
  pro

  @@map("Plan")
}

enum SubscriptionStatusValue {
  active
  canceled
  past_due
  expired

  @@map("SubscriptionStatus")
}

// 구독 결제 시도 기록 (결제 내역/감사용)
// 같은 Paddle transaction이 실패 후 성공할 수 있으므로 paddleTransactionId 기준 upsert
// 인보이스 URL은 발급 후 1시간 만료라 저장하지 않고 온디맨드로 발급
model SubscriptionOrder {
  id                  Int                          @id @default(autoincrement())
  userId              String                       @map("user_id") @db.Uuid // Cognito sub 직접 참조
  paddleTransactionId String                       @unique @map("paddle_transaction_id")
  amount              Int
  status              SubscriptionOrderStatusValue
  failReason          String?                      @map("fail_reason")
  approvedAt          DateTime?                    @map("approved_at") @db.Timestamptz(0)
  createdAt           DateTime                     @default(now()) @map("created_at") @db.Timestamptz(0)

  @@index([userId, createdAt])
  @@map("subscription_orders")
}

enum SubscriptionOrderStatusValue {
  done
  failed

  @@map("SubscriptionOrderStatus")
}

// 처리한 Paddle webhook 이벤트 (event_id 기반 멱등성 보장용)
model PaddleWebhookEvent {
  eventId    String   @id @map("event_id")
  eventType  String   @map("event_type")
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(0)

  @@map("paddle_webhook_events")
}
